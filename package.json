{
  "name": "mharj-mongoose-cache",
  "version": "0.9.4",
  "description": "mongoose model cache",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "default": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts --clean --project tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "vitest test --run --no-isolate --coverage",
    "coverage": "vitest test --run --no-isolate --reporter=dot --coverage --coverage.reporter=lcov",
    "lint": "biome check",
    "validate": "tsc --noEmit"
  },
  "files": [
    "dist"
  ],
  "repository": "github:mharj/mongoose-cache",
  "keywords": [
    "mongo",
    "mongoose",
    "cache"
  ],
  "author": "mharj",
  "license": "LGPL-2.0-only",
  "bugs": {
    "url": "https://github.com/mharj/mongoose-cache/issues"
  },
  "homepage": "https://github.com/mharj/mongoose-cache#readme",
  "devDependencies": {
    "@avanio/logger-like": "^0.2.13",
    "@biomejs/biome": "^2.5.15",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "c8": "^12.0.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.11.0",
    "tsdown": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@avanio/logger-like": ">= 0.2.10",
    "mongoose": ">= 6.0.0"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
